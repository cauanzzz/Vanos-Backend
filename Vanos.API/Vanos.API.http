@Vanos.API_HostAddress = https://localhost:7154

### Buscar todos os Motoristas
GET {{Vanos.API_HostAddress}}/api/drivers
Accept: application/json

### Cadastrar um Novo Motorista
POST {{Vanos.API_HostAddress}}/api/drivers
Content-Type: application/json

{
  "fullName": "Cauan Braga",
  "cpf": "123.456.789-00",
  "phoneNumber": "19 98888-7777",
  "licensePlate": "VAN-2026",
  "studentCapacity": 15,
  "pixKey": "cauan@email.com",
  "isActive": true
}

### Cadastrar um Novo Aluno vinculado ao Motorista 1
POST {{Vanos.API_HostAddress}}/api/students
Content-Type: application/json

{
  "fullName": "Lucas Silva",
  "guardianName": "Ana Silva",
  "guardianPhoneNumber": "19 97777-6666",
  "zipCode": "13086-900",
  "street": "Rodovia Dom Pedro I",
  "number": "Km 136",
  "complement": "Campus",
  "neighborhood": "Parque das Universidades",
  "city": "Campinas",
  "state": "SP",
  "schoolName": "PUC-Campinas",
  "driverId": 1,
  "isGoingToday": true,
  "isReturningToday": true
}

### Cadastrar uma Nova Escola
POST {{Vanos.API_HostAddress}}/api/schools
Content-Type: application/json

{
  "name": "PUC-Campinas",
  "zipCode": "13086-900",
  "street": "Rodovia Dom Pedro I",
  "number": "Km 136",
  "neighborhood": "Parque das Universidades",
  "city": "Campinas",
  "state": "SP"
}

### Gerar uma Mensalidade (Ligando o Aluno 1 ao Motorista 1)
POST {{Vanos.API_HostAddress}}/api/monthlyfees
Content-Type: application/json

{
  "studentId": 1,
  "driverId": 1,
  "amount": 350.00,
  "dueDate": "2026-08-05T00:00:00",
  "isPaid": false
}

### Buscar alunos de um motorista específico (Motorista 1)
GET {{Vanos.API_HostAddress}}/api/drivers/1/students
Accept: application/json

### Atualizar status de presença diária do Aluno 1
PATCH {{Vanos.API_HostAddress}}/api/students/1/status?isGoingToday=false&isReturningToday=true
Accept: application/json

### Cadastrar um Novo Aluno vinculado ao Motorista 1 e Escola 2
POST {{Vanos.API_HostAddress}}/api/students
Content-Type: application/json

{
  "fullName": "Lucas Silva",
  "guardianName": "Ana Silva",
  "guardianPhoneNumber": "19 97777-6666",
  "zipCode": "13086-900",
  "street": "Rodovia Dom Pedro I",
  "number": "Km 136",
  "complement": "Campus",
  "neighborhood": "Parque das Universidades",
  "city": "Campinas",
  "state": "SP",
  "schoolId": 2,
  "driverId": 1,
  "isGoingToday": true,
  "isReturningToday": true
}