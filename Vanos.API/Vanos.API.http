@Vanos.API_HostAddress = https://localhost:7154

### Buscar todos os Motoristas
GET {{Vanos.API_HostAddress}}/api/drivers
Accept: application/json

### Cadastrar um Novo Motorista
POST {{Vanos.API_HostAddress}}/api/drivers
Content-Type: application/json

{
  "fullName": "Cauan Braga",
  "cpf": "123.456.789-00",
  "phoneNumber": "19 98888-7777",
  "licensePlate": "VAN-2026",
  "studentCapacity": 15,
  "pixKey": "cauan@email.com",
  "isActive": true
}

### Cadastrar um Novo Aluno vinculado ao Motorista 1
POST {{Vanos.API_HostAddress}}/api/students
Content-Type: application/json

{
  "fullName": "Lucas Silva",
  "guardianName": "Ana Silva",
  "guardianPhoneNumber": "19 97777-6666",
  "zipCode": "13086-900",
  "street": "Rodovia Dom Pedro I",
  "number": "Km 136",
  "complement": "Campus",
  "neighborhood": "Parque das Universidades",
  "city": "Campinas",
  "state": "SP",
  "schoolName": "PUC-Campinas",
  "driverId": 1,
  "isGoingToday": true,
  "isReturningToday": true
}